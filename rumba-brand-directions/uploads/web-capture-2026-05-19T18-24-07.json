ver -->\n<script>\n(function() {\n  var socialIcons = document.querySelectorAll('.wp-social-icon');\n  var ctaButton = document.getElementById('wp-cta-button');\n  \n  // Animación hover para iconos sociales\n  socialIcons.forEach(function(icon) {\n    var circle = icon.querySelector('.wp-icon-circle');\n    \n    icon.addEventListener('mouseenter', function() {\n      icon.style.transform = 'translateY(-8px)';\n      icon.style.boxShadow = '0 8px 20px rgba(46, 157, 78, 0.5)';\n      circle.style.transform = 'scale(1.1)';\n    });\n    \n    icon.addEventListener('mouseleave', function() {\n      icon.style.transform = 'translateY(0)';\n      icon.style.boxShadow = 'none';\n      circle.style.transform = 'scale(1)';\n    });\n  });\n  \n  // Animación hover para botón CTA\n  ctaButton.addEventListener('mouseenter', function() {\n    ctaButton.style.transform = 'scale(1.03)';\n    ctaButton.style.boxShadow = '0 8px 25px rgba(232, 76, 138, 0.5)';\n  });\n  \n  ctaButton.addEventListener('mouseleave', function() {\n    ctaButton.style.transform = 'scale(1)';\n    ctaButton.style.boxShadow = 'none';\n  });\n\n  function applyResponsive() {\n    var container = document.getElementById('wp-cta-container');\n    var button = document.getElementById('wp-cta-button');\n    var cursor = document.getElementById('wp-cursor-icon');\n    var socialContainer = document.getElementById('wp-social-icons');\n    var icons = document.querySelectorAll('.wp-social-icon');\n    var circles = document.querySelectorAll('.wp-icon-circle');\n    var svgs = document.querySelectorAll('.wp-icon-circle svg');\n    \n    if (window.innerWidth <= 480) {\n      container.style.flexDirection = 'column';\n      container.style.flexWrap = 'wrap';\n      container.style.alignItems = 'center';\n      container.style.gap = '30px';\n      container.style.padding = '0 20px';\n      \n      button.style.width = '280px';\n      button.style.height = '110px';\n      button.style.fontSize = '1.3rem';\n      button.style.padding = '20px 80px 25px 25px';\n      \n      cursor.style.width = '55px';\n      cursor.style.height = '55px';\n      cursor.style.top = '10px';\n      cursor.style.right = '10px';\n      \n      icons.forEach(function(icon) {\n        icon.style.width = '55px';\n        icon.style.height = '100px';\n        icon.style.paddingTop = '12px';\n      });\n      \n      circles.forEach(function(circle) {\n        circle.style.width = '38px';\n        circle.style.height = '38px';\n      });\n      \n      svgs.forEach(function(svg) {\n        svg.style.width = '20px';\n        svg.style.height = '20px';\n      });\n    } else {\n      container.style.flexDirection = 'row';\n      container.style.flexWrap = 'nowrap';\n      container.style.alignItems = 'flex-end';\n      container.style.gap = '120px';\n      container.style.padding = '0 100px';\n      \n      button.style.width = '380px';\n      button.style.height = '140px';\n      button.style.fontSize = '1.8rem';\n      button.style.padding = '30px 100px 35px 40px';\n      \n      cursor.style.width = '75px';\n      cursor.style.height = '75px';\n      cursor.style.top = '12px';\n      cursor.style.right = '15px';\n      \n      icons.forEach(function(icon) {\n        icon.style.width = '80px';\n        icon.style.height = '140px';\n        icon.style.paddingTop = '18px';\n      });\n      \n      circles.forEach(function(circle) {\n        circle.style.width = '52px';\n        circle.style.height = '52px';\n      });\n      \n      svgs.forEach(function(svg) {\n        svg.style.width = '26px';\n        svg.style.height = '26px';\n      });\n    }\n  }\n  \n  applyResponsive();\n  window.addEventListener('resize', applyResponsive);\n})();\n</script>\n\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t</section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-7296ad2 elementor-section-full_width elementor-section-height-